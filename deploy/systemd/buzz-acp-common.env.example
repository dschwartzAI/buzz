# /etc/buzz-acp/common.env
# Non-secret settings shared by every agent on this host.

# Use the operator's timezone so unattended agents reason about local time.
TZ=Etc/UTC

# Allow two concurrent turns per identity. A global heartbeat is configured
# only on the coordinator that should proactively scan for work.
BUZZ_ACP_AGENTS=2

# Every harness receives the same inbound author policy and team instructions.
BUZZ_ACP_SUBSCRIBE=mentions
BUZZ_ACP_RESPOND_TO=owner-only
# For a team, change the mode to allowlist and list its public keys:
# BUZZ_ACP_RESPOND_TO_ALLOWLIST=<pubkey>,<pubkey>
BUZZ_ACP_TEAM_INSTRUCTIONS_FILE=/etc/buzz-acp/team-instructions.md

# Extend this once for shared operator tools instead of adding per-agent PATH
# overrides. Keep the standard system paths available.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
