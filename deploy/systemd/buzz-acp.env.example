# /etc/buzz-acp/<unix-user>.env
# chmod 600

# Agent Nostr identity (hex 64 or nsec1…)
BUZZ_PRIVATE_KEY=

# MUST match Buzz Desktop relay host string exactly (community selector)
BUZZ_RELAY_URL=ws://buzz.example.com:3000

# ACP agent binary + args (comma-separated args for buzz-acp)
BUZZ_ACP_AGENT_COMMAND=goose
# BUZZ_ACP_AGENT_ARGS=

# Inbound policy normally belongs in common.env. Override here only when this
# identity intentionally subscribes to a different audience.
# BUZZ_ACP_DISPLAY_NAME=Coder
# BUZZ_ACP_SYSTEM_PROMPT_FILE=/etc/buzz-acp/buzz-coder.prompt.md
